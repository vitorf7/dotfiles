# nixos/nix-config/secrets/ — wiresteward-secrets.nix stays on strongbox because it
# is imported at nix eval time (sops-nix cannot provide values at eval time).
secrets/* filter=strongbox diff=strongbox
secrets/**/* filter=strongbox diff=strongbox
nixos/nix-config/secrets/* filter=strongbox diff=strongbox
nixos/nix-config/secrets/**/* filter=strongbox diff=strongbox
